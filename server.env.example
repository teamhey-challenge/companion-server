# 이름만 있는 예시 파일. 실제 값은 ~/.config/companion/server.env (chmod 600)에 둔다.
# 기본: LLM_PROVIDER=openai-compatible, LLM_MODEL=chat-fast (OmniRoute)
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
COMPANION_PROVISION_SECRET=
# 서버 TTS: BREEZE_API_KEY 가 있으면 BreezeBlue, COMPANION_TTS_PROVIDER=fake|off 로 바꿀 수 있다.
BREEZE_API_KEY=
COMPANION_TRUST_PROXY=
